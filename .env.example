# ============================================================
# POLYMARKET HFT BOT - Configuration
# Copy this file to .env and fill in the values
# ============================================================

# --- MODE ---
# paper  = simulation with no real money (default, RECOMMENDED to start)
# live   = real trading with USDC on Polygon
BOT_MODE=paper

# --- POLYMARKET CLOB API ---
# Get these at: https://polymarket.com (profile -> API Keys)
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# Polygon wallet used to sign transactions (live only)
POLY_PRIVATE_KEY=
POLY_CHAIN_ID=137

# --- TRADING PARAMETERS ---
# Starting capital available (USDC)
INITIAL_CAPITAL=1000.0

# Maximum bet size per trade (% of capital)
MAX_BET_PCT=0.05

# Minimum required edge (gap between true probability and the market)
MIN_EDGE=0.03

# Minimum win probability required to enter
MIN_WIN_PROBABILITY=0.60

# Minimum expected value
MIN_EXPECTED_VALUE=0.02

# Maximum simultaneous open positions
MAX_OPEN_POSITIONS=8

# Kelly multiplier (0.25 = conservative fractional Kelly)
KELLY_FRACTION=0.25

# Main loop interval in milliseconds
CYCLE_INTERVAL_MS=200

# --- PRICE APIS ---
# Alpha Vantage (gold/commodities) - free at alphavantage.co
ALPHA_VANTAGE_KEY=

# Binance (crypto) - no key required for public data
BINANCE_TESTNET=false

# --- MARKET FILTERS ---
# Categories to trade: crypto,commodities (comma-separated)
TARGET_CATEGORIES=crypto,commodities

# Minimum market liquidity (USDC)
MIN_MARKET_LIQUIDITY=500

# Minimum hours until the market resolves
MIN_HOURS_TO_EXPIRY=1

# Maximum hours until resolution
# Crypto markets on Polymarket expire in months/years
# 17520 = 2 years | 8760 = 1 year | 2160 = 3 months
MAX_HOURS_TO_EXPIRY=17520

# --- FAST STRATEGY: 5m and 15m Up/Down markets ---
ENABLE_FAST=true
# ALL of these are followed and written to the journal (logs/calibration.csv); only the backtest-validated ones are TRADED.
# HYPE and the 4h windows do not have enough evidence: use `python calibration.py` to decide when to trade them.
FAST_ASSETS=BTC,ETH,SOL,XRP,DOGE,BNB,HYPE
FAST_TIMEFRAMES=5m,15m,4h
FAST_TRADE_ASSETS=BTC,ETH,SOL,XRP,DOGE,BNB
FAST_TRADE_TIMEFRAMES=5m,15m
# Combined cap (positions + in-flight orders) as % of capital: crypto assets move together
MAX_EXPOSURE_PCT=0.25
# Minimum net edge (after fees) required to enter
FAST_MIN_EDGE=0.08
# Model volatility and leftover Binance/Chainlink basis noise (chosen in training, checked on the test set)
FAST_SIGMA_MULT=1.0
FAST_BASIS=0.0001
# Live websockets (if they fail, it falls back to REST on its own)
FAST_USE_WS=true
# Calibration journal (predictions and real outcomes)
FAST_JOURNAL=true
# Model price: chainlink (Chainlink stream only) or blend (exchange median + basis). The journal records both
# so `python calibration.py` (section 4) can compare them.
FAST_PRICE_SOURCE=chainlink
# Trade only windows whose Chainlink reference was seen live (avoids false edges near the price to beat)
FAST_REQUIRE_EXACT_REF=true
# Minimum gap between cycles (the loop wakes on each update). 1 ms = faster reaction and more CPU
REACT_MIN_INTERVAL_MS=1

# --- REALISTIC PAPER SIMULATION ---
# The order takes this long to reach the book and fills only if the ask does not move more than PAPER_MAX_SLIPPAGE
PAPER_FILL_LATENCY_MS=150
PAPER_MAX_SLIPPAGE=0.01

# --- PROFIT COLLECTION (live keys: C collect basket, X close all, P pause, A auto on/off) ---
AUTO_COLLECT=true
# Sell a position after this net gain (collecting earlier earns less but hits more often; see README)
LOCK_PROFIT_PCT=0.30
# Collect the whole basket in profit once it sums to this % of capital (0 = off; not backtested)
BASKET_TARGET_PCT=0.03

# Long markets (expire in months; lock capital; not validated). Off.
ENABLE_LONG_MARKETS=false
